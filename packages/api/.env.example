# GoodPint API configuration.
#
# Copy to packages/api/.env (or export these in your process manager) and fill
# in real values. Never commit a filled-in copy — .env is gitignored.

# ---------------------------------------------------------------------------
# Required in production. The process refuses to start without them.
# ---------------------------------------------------------------------------

# Shared secret a pub's till presents to redeem vouchers. Minimum 24 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STAFF_KEY=

# Optional: give each venue its own till key so one leaked credential cannot
# redeem vouchers across every pub. Format: venueId:key,venueId:key
# When set, this takes precedence over STAFF_KEY.
# STAFF_KEYS=venue-1:xxxxxxxxxxxxxxxxxxxxxxxxxxxx,venue-2:yyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# Where the SQLite file lives. Must be on a volume that is backed up and is not
# served over HTTP.
# GOODPINT_DB_PATH=/var/lib/goodpint/goodpint.db

# How many reverse proxies sit in front of this process.
# 0 = no proxy (the default). Set to 1 behind a single load balancer.
# Too high and a client can spoof X-Forwarded-For to shed every rate limit;
# too low and every user shares one rate-limit bucket.
TRUST_PROXY_HOPS=0

# Browser origins allowed to call the API, comma separated. Native apps are
# unaffected. Empty means same-origin only. "*" is rejected.
# CORS_ALLOWED_ORIGINS=https://app.goodpint.example

# Require HTTPS and send HSTS. Defaults to on in production.
ENFORCE_HTTPS=true

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# POST /api/wallet/top-up credits a wallet with spendable money. No payment
# provider is integrated, so with this enabled any signed-in user can mint funds.
# Leave false until a provider actually authorises the charge upstream.
ALLOW_UNVERIFIED_TOPUPS=false

# ---------------------------------------------------------------------------
# Limits (all optional — sensible defaults are built in)
# ---------------------------------------------------------------------------

# SESSION_TTL_HOURS=720            # absolute session lifetime (default 30 days)
# SESSION_IDLE_TTL_HOURS=336       # expire after inactivity (default 14 days)
# MAX_SESSIONS_PER_USER=10
# MIN_PASSWORD_LENGTH=10
# CHECK_IN_COOLDOWN_HOURS=4        # per user, per venue
# CHECK_IN_DAILY_POINT_CAP=100     # per user, per rolling day

# Network interface to bind. Defaults to 0.0.0.0 so a phone on the same Wi-Fi
# can reach a dev server. In production bind loopback and put a TLS-terminating
# reverse proxy in front, so the staff till endpoint is not exposed to the LAN.
# HOST=127.0.0.1
