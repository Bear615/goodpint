{
  "name": "@goodpint/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--experimental-sqlite node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite node --import tsx --test src/security.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
